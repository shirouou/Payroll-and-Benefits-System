NODE_ENV=development
PORT=5000

# Database
# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/payroll-benefits

# JWT Authentication
JWT_SECRET=replace-with-a-long-random-secret-min-32-characters
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-min-32-characters
JWT_REFRESH_EXPIRE=30d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Frontend URL (for password reset links, etc.)
FRONTEND_URL=http://localhost:5173

# Encryption (for sensitive data at rest)
ENCRYPTION_KEY=replace-with-a-long-encryption-key-min-32-characters

# Logging
LOG_LEVEL=info

# API Configuration
API_URL=http://localhost:5000

# Email Configuration (for password reset emails, notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@payrollsystem.com

# 2FA Configuration
TWO_FACTOR_EXPIRY=300000

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_ATTEMPT_MAX=5
LOGIN_ATTEMPT_LOCKOUT_TIME=7200000

# Session Management
SESSION_TIMEOUT=86400000
REFRESH_TOKEN_ROTATION=true

# Admin Configuration (default admin user)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional: change when deploying to production
